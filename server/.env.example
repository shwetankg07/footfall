PORT=8080
MONGO_URI=mongodb://127.0.0.1:27017
# Database name is set explicitly; a URI without one would silently use "test".
MONGO_DB=footfall
JWT_SECRET=
# Dashboard origin(s) allowed to open sockets, comma-separated, no trailing slash.
CLIENT_URL=http://localhost:5173
# Shared with the hourly ML job, which calls POST /internal/alerts/flush.
INTERNAL_SECRET=
# Optional: alert emails. Without a key, alerts still show up in the dashboard.
RESEND_API_KEY=
ALERT_FROM_EMAIL=Footfall <onboarding@resend.dev>
# Optional: Razorpay test keys for Pro checkout. Without them, checkout says payments aren't set up.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NODE_ENV=development
